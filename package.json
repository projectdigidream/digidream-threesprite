{
  "name": "threesprite",
  "license": "MIT",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "Animated multi-view sprite editor for games with billboard characters (desktop, Android, browser).",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "tsc --noEmit && vite build --config vite.config.web.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "tauri": "tauri",
    "apk": "bash scripts/android-apk.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "immer": "^11.1.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  }
}
