!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS
.DS_Store

# smoke-driver output
drive-out/

# VS Code extension build output (media/ is the copied web bundle)
vscode/out/
vscode/media/
vscode/*.vsix

# Engine runtime build output
runtime/out/
runtime/out-types/

# the copy of the newest Android build that lands at the root
/PrSpr-editor.apk

# --- Shared by every repository of the workspace. These lines came from the
# workspace's .gitignore, which covered this folder until it became a
# repository of its own (2026-10-14).
build/
builds/
dist/
node_modules/
.cache/
*.o
*.a
*.dSYM/
.DS_Store
compile_commands.json
*~
# Development TLS material: the private key must never be committed.
certs/
*.pem
# Rendered audio is output, regenerated by running the renderer again; git
# history is permanent, so one accidental add would weigh the repository down.
*.wav
