{
  "name": "prspr-vscode",
  "displayName": "PrSpr editor",
  "description": "Edit animated multi-view sprite projects (.tsprite) in an editor tab.",
  "version": "0.2.5",
  "publisher": "digidream",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "sprite",
    "pixel art",
    "animation",
    "gamedev"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "prspr-editor.editor",
        "displayName": "PrSpr editor",
        "selector": [
          {
            "filenamePattern": "*.tsprite"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "prspr-editor.newProject",
        "title": "New Sprite Project",
        "category": "PrSpr editor"
      }
    ]
  },
  "scripts": {
    "build:app": "node scripts/copy-app.mjs",
    "compile": "tsc -p .",
    "build": "npm run build:app && npm run compile",
    "test": "npm run compile && node --test test/*.test.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --out prspr-editor.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.8.0"
  },
  "icon": "icon.png"
}
